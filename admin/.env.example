# ============================================================
# Cravio Administrative Dashboard Environment Configuration Template
# Copy this file to .env and fill in your values.
# ============================================================

# ── Backend API URL ─────────────────────────────────────────
# Local development: http://localhost:5000
# Production: https://your-backend-deployment.onrender.com
VITE_API_URL=http://localhost:5000

# ── Admin Secret Key ────────────────────────────────────────
# Must match the ADMIN_SECRET or JWT_SECRET configured in backend
VITE_ADMIN_SECRET=cravio_secret_key_change_this_in_production
