# ============================================================
# Cravio Backend Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file containing secrets to git!
# ============================================================

# ── Server Port & Runtime Environment ──────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB Database Connection URI ────────────────────────
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/cravio?retryWrites=true&w=majority

# ── JWT Secret for User & Admin Token Signing ───────────────
# Generate a secure 64-character random string in production
JWT_SECRET=your_jwt_secret_key_change_this_in_production

# ── Admin Secret Key (Optional Fallback for Decoupled Admin) ─
ADMIN_SECRET=cravio_secret_key_change_this_in_production

# ── Cloudinary Media Storage Credentials ───────────────────
# Obtain from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Razorpay Payment Gateway Credentials ───────────────────
# Obtain from https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ── Google Gemini AI Assistant ─────────────────────────────
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key
