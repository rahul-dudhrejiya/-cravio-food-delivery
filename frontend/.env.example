# ============================================================
# Cravio Customer Frontend Environment Configuration Template
# Copy this file to .env and fill in your values.
# ============================================================

# ── Backend API URL ─────────────────────────────────────────
# Local development: http://localhost:5000
# Production: https://your-backend-deployment.onrender.com
VITE_API_URL=http://localhost:5000

# ── Razorpay Public Key ID ─────────────────────────────────
# Public client-side test or live key ID (Key Secret stays strictly on server!)
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
